# Server Configuration
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
CALL_AGENT_LOG_FILE=logs/call-agent.log
PLAY_GREETING=true
ENABLE_BARGE_IN=false

# Exotel Telephony & AgentStream Configuration
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=your_exotel_virtual_number
EXOTEL_STREAM_URL=wss://your-public-domain.example/ws/exotel/stream
EXOTEL_CALL_TIMEOUT_SECONDS=30
EXOTEL_CALL_TIME_LIMIT_SECONDS=3600

# Voice Processing (Sarvam AI STT/TTS)
VOICE_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DEFAULT_LANGUAGE_CODE=en-IN
SARVAM_DEFAULT_SPEAKER=shubh

# NVIDIA NIM (https://build.nvidia.com). Production calls use the data API's
# NIM tool-calling agent; this key is used directly only in CALL_AGENT_TEST_MODE.
AI_PROVIDER=backend
NVIDIA_API_KEY=nvapi-your_key
NIM_MODEL=openai/gpt-oss-20b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
CALL_AGENT_TEST_MODE=false

# Main SALTY marine agent (data API)
AI_BACKEND_URL=http://127.0.0.1:8010
AI_BACKEND_TIMEOUT_SECONDS=45.0
AI_BACKEND_MAX_RETRIES=1
AI_BACKEND_RETRY_DELAY_SECONDS=0.5

# Audio & Voice Activity Detection (VAD) Settings
AUDIO_SAMPLE_RATE=8000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2
AUDIO_CHUNK_BYTES=3200
VAD_RMS_THRESHOLD=350
VAD_MIN_SPEECH_MS=250
VAD_SILENCE_MS=800
VAD_MAX_BUFFER_SECONDS=15.0

# Natural Conversation Settings
MAX_CONVERSATION_HISTORY_TURNS=10
DEFAULT_FALLBACK_LANGUAGE=en-IN
