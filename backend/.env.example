# SALTY data API + marine agent (backend/api_server.py)
# Copy to backend/.env

SALTY_API_PORT=8010

# NVIDIA NIM (https://build.nvidia.com) - the marine agent's LLM.
# The model must support tool calling; openai/gpt-oss-20b does.
NVIDIA_API_KEY=nvapi-your_key
# Optional: several keys from different accounts, rotated on HTTP 429.
# NVIDIA_API_KEYS=nvapi-key1,nvapi-key2
NIM_MODEL=openai/gpt-oss-20b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
